.DS_Store

# Environment files
.env
.env.*
!.env.example

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Backend build output
backend/.gradle/
backend/build/

# IDE-generated files
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
*.iml

# Operator-local AWS parameters (never commit origin-header or account values)
infra/aws/parameters/*.json
!infra/aws/parameters/*.example.json

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated Graphify output
graphify-out/

# Locally installed Codex skills
.codex/skills/graphify/
